-buildpath:  \
	osgi.core,\
	osgi.cmpn,\
	biz.aQute.bnd.annotation,\
	${junit},\
	activiti-osgi,\
	org.activiti.camel,\
	org.activiti.engine;version=5.17
Bundle-Version: 0.0.0.${tstamp}
Service-Component:  \
	*
-runrequires:  \
	osgi.identity;filter:='(osgi.identity=org.apache.felix.configadmin)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.fileinstall)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.scr)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.log)',\
	osgi.identity;filter:='(&(osgi.identity=org.activiti.engine)(version>=5.17.0))',\
	osgi.identity;filter:='(&(osgi.identity=org.activiti.bpmn.converter)(version>=5.17.0))',\
	osgi.identity;filter:='(&(osgi.identity=org.activiti.bpmn.model)(version>=5.17.0))',\
	osgi.identity;filter:='(&(osgi.identity=com.fasterxml.jackson.core.jackson-core)(version>=2.5.2))',\
	osgi.identity;filter:='(&(osgi.identity=com.fasterxml.jackson.core.jackson-databind)(version>=2.5.2))',\
	osgi.identity;filter:='(&(osgi.identity=com.fasterxml.jackson.core.jackson-annotations)(version>=2.5.2))',\
	osgi.identity;filter:='(&(osgi.identity=org.activiti.image)(version>=5.17.0))',\
	osgi.identity;filter:='(&(osgi.identity=org.activiti.validation)(version>=5.17.0))',\
	osgi.identity;filter:='(&(osgi.identity=org.apache.servicemix.bundles.mybatis)(version>=3.2.2.1))',\
	osgi.identity;filter:='(&(osgi.identity=joda-time)(version>=2.6.0))',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.command)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.runtime)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.shell)'
-runfw: org.apache.felix.framework;version='[4.4.1,4.4.1]'
-runee: JavaSE-1.7

-runbundles:  \
	ch.qos.logback.classic;version='[1.1.2,1.1.3)',\
	ch.qos.logback.core;version='[1.1.2,1.1.3)',\
	com.fasterxml.jackson.core.jackson-annotations;version='[2.5.2,2.5.3)',\
	com.fasterxml.jackson.core.jackson-core;version='[2.5.2,2.5.3)',\
	com.fasterxml.jackson.core.jackson-databind;version='[2.5.2,2.5.3)',\
	com.springsource.javassist;version='[3.15.0,3.15.1)',\
	joda-time;version='[2.6.0,2.6.1)',\
	org.activiti.bpmn.converter;version='[5.17.0,5.17.1)',\
	org.activiti.bpmn.model;version='[5.17.0,5.17.1)',\
	org.activiti.engine;version='[5.17.0,5.17.1)',\
	org.activiti.image;version='[5.17.0,5.17.1)',\
	org.activiti.validation;version='[5.17.0,5.17.1)',\
	org.apache.commons.lang3;version='[3.3.2,3.3.3)',\
	org.apache.felix.configadmin;version='[1.8.2,1.8.3)',\
	org.apache.felix.fileinstall;version='[3.4.0,3.4.1)',\
	org.apache.felix.gogo.command;version='[0.14.0,0.14.1)',\
	org.apache.felix.gogo.runtime;version='[0.10.0,0.10.1)',\
	org.apache.felix.gogo.runtime;version='[0.12.1,0.12.2)',\
	org.apache.felix.gogo.shell;version='[0.10.0,0.10.1)',\
	org.apache.felix.log;version='[1.0.1,1.0.2)',\
	org.apache.felix.scr;version='[1.8.2,1.8.3)',\
	org.apache.servicemix.bundles.mybatis;version='[3.2.2,3.2.3)',\
	osgi.residential;version='[4.3.0,4.3.1)',\
	slf4j.api;version='[1.7.7,1.7.8)'
-resolve: auto
Export-Package:  \
	com.flow.activiti.osgi