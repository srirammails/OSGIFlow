Bundle-Version: 0.0.0.${tstamp}
Vaadin-Resources:resource
-buildpath:  \
	osgi.core;version=4.3,\
	com.vaadin.server,\
	com.vaadin.shared,\
	org.apache.felix.scr,\
	osgi.cmpn;version=4.3,\
	com.vaadin.client,\
	org.json,\
	slf4j.api,\
	slf4j.simple,\
	biz.aQute.bnd.annotation,\
	biz.aQute.bnd,\
	ShellXAPI;version=latest,\
	org.apache.felix.eventadmin,\
	javax.servlet;version=2.5
-runee: JavaSE-1.7
-runfw: org.apache.felix.framework;version='[4.4.1,4.4.1]'
-runrequires:  \
	osgi.identity;filter:='(&(osgi.identity=osgi.cmpn)(version>=4.3.1.201210102024))',\
	osgi.identity;filter:='(&(osgi.identity=org.apache.felix.configadmin)(version>=1.8.2))',\
	osgi.identity;filter:='(&(osgi.identity=org.apache.felix.log)(version>=1.0.1))',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.http.api)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.http.servlet-api)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.http.jetty)',\
	osgi.identity;filter:='(osgi.identity=com.vaadin.client-compiled)',\
	osgi.identity;filter:='(osgi.identity=com.vaadin.server)',\
	osgi.identity;filter:='(osgi.identity=com.vaadin.shared)',\
	osgi.identity;filter:='(osgi.identity=com.vaadin.themes)',\
	osgi.identity;filter:='(osgi.identity=org.json)',\
	osgi.identity;filter:='(osgi.identity=org.jsoup)',\
	osgi.identity;filter:='(osgi.identity=slf4j.api)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.scr)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.log)',\
	osgi.identity;filter:='(&(osgi.identity=org.apache.felix.metatype)(version>=1.0.10))',\
	osgi.identity;filter:='(&(osgi.identity=biz.aQute.bnd.annotation)(version>=2.4.0.201411031537))',\
	osgi.identity;filter:='(&(osgi.identity=osgi.enterprise)(version>=5.0.0.201203141834))',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.webconsole)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.fileinstall)',\
	osgi.identity;filter:='(osgi.identity=ShellXAPI)'
Service-Component:  \
	*
-runbundles:  \
	ShellXAPI;version=latest,\
	biz.aQute.bnd.annotation;version='[2.4.0,2.4.1)',\
	ch.qos.logback.classic;version='[1.1.2,1.1.3)',\
	ch.qos.logback.core;version='[1.1.2,1.1.3)',\
	com.google.gwt.thirdparty.guava;version='[16.0.1,16.0.2)',\
	com.google.gwt.thirdparty.streamhtmlparser;version='[0.0.10,0.0.11)',\
	com.vaadin.client-compiled;version='[7.3.10,7.3.11)',\
	com.vaadin.server;version='[7.3.10,7.3.11)',\
	com.vaadin.shared;version='[7.3.10,7.3.11)',\
	com.vaadin.themes;version='[7.3.10,7.3.11)',\
	javax.jdo;version='[3.1.0,3.1.1)',\
	org.amdatu.persistence2_1;version='[1.0.0,1.0.1)',\
	org.apache.camel.camel-core;version='[2.15.0,2.15.1)',\
	org.apache.felix.configadmin;version='[1.8.4,1.8.5)',\
	org.apache.felix.fileinstall;version='[3.5.0,3.5.1)',\
	org.apache.felix.http.api;version='[2.3.2,2.3.3)',\
	org.apache.felix.http.jetty;version='[2.3.0,2.3.1)',\
	org.apache.felix.http.servlet-api;version='[1.0.0,1.0.1)',\
	org.apache.felix.log;version='[1.0.1,1.0.2)',\
	org.apache.felix.metatype;version='[1.0.10,1.0.11)',\
	org.apache.felix.scr;version='[1.8.2,1.8.3)',\
	org.apache.felix.webconsole;version='[4.2.2,4.2.3)',\
	org.apache.geronimo.specs.geronimo-jta_1.1_spec;version='[1.1.1,1.1.2)',\
	org.json;version='[0.0.20080701,0.0.20080702)',\
	org.jsoup;version='[1.6.3,1.6.4)',\
	org.w3c.flute;version='[1.3.0,1.3.1)',\
	osgi.cmpn;version='[5.0.0,5.0.1)',\
	osgi.enterprise;version='[4.2.0,4.2.1)',\
	osgi.enterprise;version='[5.0.0,5.0.1)',\
	slf4j.api;version='[1.7.7,1.7.8)'
-resolve: auto
Export-Package:  \
	com.flow.shellx.api,\
	com.flow.shellx.proxy,\
	com.flow.vaadin.osgi.api
Private-Package:  \
	com.flow.shellx.proxy,\
	com.flow.vaadin.osgi,\
	com.flow.vaadin.osgi.servlet,\
	com.flow.vaadin.osgi.api.base
-runvm: -Dorg.osgi.service.http.port=80