Bundle-Version: 0.0.0.${tstamp}
-runfw: org.apache.felix.framework;version='[4.4.1,4.4.1]'
-runee: JavaSE-1.7
-resolve: auto
-buildpath:  \
	com.vaadin.server,\
	com.vaadin.shared,\
	osgi.core;version=4.3,\
	javax.jdo,\
	osgi.cmpn;version=4.3,\
	org.apache.camel.camel-core;version=2.15,\
	org.apache.camel.camel-core-osgi;version=2.15,\
	javax.persistence;version=2.1
Export-Package:  \
	com.flow.shellx.api,\
	com.flow.shellx.proxy
-runrequires:  \
	osgi.identity;filter:='(osgi.identity=com.vaadin.client)',\
	osgi.identity;filter:='(osgi.identity=com.vaadin.client-compiled)',\
	osgi.identity;filter:='(osgi.identity=com.vaadin.themes)',\
	osgi.identity;filter:='(&(osgi.identity=javax.persistence)(version=2.1.0.v201304241213))'
-runbundles:  \
	com.vaadin.client;version='[7.3.10,7.3.11)',\
	com.vaadin.client-compiled;version='[7.3.10,7.3.11)',\
	com.vaadin.themes;version='[7.3.10,7.3.11)',\
	javax.persistence;version='[2.1.0,2.1.1)'