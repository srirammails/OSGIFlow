Bundle-Version: 0.0.0.${tstamp}
-buildpath:  \
	osgi.cmpn;version=4.3,\
	javax.persistence,\
	biz.aQute.bnd.annotation,\
	osgi.core;version=4.3,\
	org.datanucleus,\
	org.datanucleus.jpa,\
	org.datanucleus.api.jpa,\
	org.datanucleus.store.rdbms,\
	org.datanucleus.api.jdo,\
	javax.jdo,\
	org.ops4j.pax.jdbc.mysql,\
	com.springsource.com.mysql.jdbc,\
	ShellXAPI;version=latest
