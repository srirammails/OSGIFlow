	com.flow.jdo.osgi,\
	com.flow.osgi.persistence.api
-runrequires:  \
	osgi.identity;filter:='(&(osgi.identity=osgi.cmpn)(version>=4.3.1.201210102024))',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.configadmin)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.scr)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.command)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.runtime)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.shell)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.log)',\
	osgi.identity;filter:='(osgi.identity=org.datanucleus)',\
	osgi.identity;filter:='(osgi.identity=org.datanucleus.api.jdo)',\
	osgi.identity;filter:='(osgi.identity=org.datanucleus.store.rdbms)',\
	osgi.identity;filter:='(osgi.identity=javax.jdo)',\
	osgi.identity;filter:='(osgi.identity=javax.persistence)',\
	osgi.identity;filter:='(osgi.identity=com.springsource.com.mysql.jdbc)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.fileinstall)',\
	osgi.identity;filter:='(osgi.identity=ShellXOSGICommonsBridge)',\
	osgi.identity;filter:='(osgi.identity=biz.aQute.bnd.annotation)',\
	osgi.identity;filter:='(osgi.identity=org.apache.servicemix.bundles.joda-time)',\
	osgi.identity;filter:='(osgi.identity=ShellXAPI)',\
	osgi.identity;filter:='(&(osgi.identity=org.datanucleus.jpa)(version>=2.1.8))'
-runfw: org.apache.felix.framework;version='[4.4.1,4.4.1]'
-runee: JavaSE-1.7
-resolve: auto
-runbundles:  \
	ShellXAPI;version=latest,\
	ShellXOSGICommonsBridge;version=latest,\
	biz.aQute.bnd.annotation;version='[2.4.0,2.4.1)',\
	com.google.gwt.thirdparty.guava;version='[16.0.1,16.0.2)',\
	com.google.gwt.thirdparty.streamhtmlparser;version='[0.0.10,0.0.11)',\
	com.springsource.com.mysql.jdbc;version='[5.1.6,5.1.7)',\
	com.springsource.org.apache.commons.logging;version='[1.1.1,1.1.2)',\
	com.vaadin.server;version='[7.3.10,7.3.11)',\
	com.vaadin.shared;version='[7.3.10,7.3.11)',\
	javax.jdo;version='[3.1.0,3.1.1)',\
	javax.persistence;version='[2.1.0,2.1.1)',\
	org.apache.felix.configadmin;version='[1.8.2,1.8.3)',\
	org.apache.felix.fileinstall;version='[3.4.0,3.4.1)',\
	org.apache.felix.gogo.command;version='[0.14.0,0.14.1)',\
	org.apache.felix.gogo.runtime;version='[0.10.0,0.10.1)',\
	org.apache.felix.gogo.runtime;version='[0.12.1,0.12.2)',\
	org.apache.felix.gogo.shell;version='[0.10.0,0.10.1)',\
	org.apache.felix.http.servlet-api;version='[1.0.0,1.0.1)',\
	org.apache.felix.log;version='[1.0.1,1.0.2)',\
	org.apache.felix.scr;version='[1.8.2,1.8.3)',\
	org.apache.servicemix.bundles.joda-time;version='[2.3.0,2.3.1)',\
	org.datanucleus;version='[4.0.4,4.0.5)',\
	org.datanucleus.api.jdo;version='[4.0.4,4.0.5)',\
	org.datanucleus.jpa;version='[2.1.8,2.1.9)',\
	org.datanucleus.store.rdbms;version='[4.0.5,4.0.6)',\
	org.json;version='[0.0.20080701,0.0.20080702)',\
	org.jsoup;version='[1.6.3,1.6.4)',\
	org.w3c.flute;version='[1.3.0,1.3.1)',\
	osgi.cmpn;version='[5.0.0,5.0.1)',\
	osgi.enterprise;version='[4.2.0,4.2.1)'
DataNucleus-Model: UserModel
