-buildpath:  \
	osgi.core,\
	osgi.cmpn,\
	${junit},\
	org.datanucleus.api.jdo,\
	javax.jdo,\
	javax.persistence,\
	org.datanucleus,\
	org.datanucleus.store.rdbms,\
	com.vaadin.server,\
	com.vaadin.shared,\
	ShellXAPI;version=latest,\
	org.json,\
	com.springsource.javax.validation,\
	biz.aQute.bnd.annotation
Bundle-Version: 0.0.0.${tstamp}
Meta-Persistence: META-INF/persistence.xml
Service-Component:  \
	*
Export-Package:  \
	com.flow.pjm.component,\
	com.flow.shell.component,\
	com.flow.model.pjm
Include-Resource: resources
Vaadin-Resources:resource
-runfw: org.apache.felix.framework;version='[4.2.1,4.2.1]'
-runee: JavaSE-1.7
-runproperties: \
    org.osgi.framework.bootdelegation=sun.*,com.sun.*
-runvm: -Dorg.osgi.service.http.port=80
-runrequires:  \
	osgi.identity;filter:='(&(osgi.identity=org.apache.felix.configadmin)(version>=1.8.2))',\
	osgi.identity;filter:='(&(osgi.identity=org.apache.felix.fileinstall)(version>=3.4.0))',\
	osgi.identity;filter:='(&(osgi.identity=org.apache.felix.scr)(version>=1.8.2))',\
	osgi.identity;filter:='(osgi.identity=ShellXAPI)',\
	osgi.identity;filter:='(osgi.identity=ShellXOSGICommonsBridge)',\
	osgi.identity;filter:='(osgi.identity=ShellXVaadinBridge)'
-runbundles:  \
	ShellXAPI;version=latest,\
	ShellXOSGICommonsBridge;version=latest,\
	ShellXVaadinBridge;version=latest,\
	biz.aQute.bnd.annotation;version='[2.4.0,2.4.1)',\
	ch.qos.logback.classic;version='[1.1.2,1.1.3)',\
	ch.qos.logback.core;version='[1.1.2,1.1.3)',\
	com.google.gwt.thirdparty.guava;version='[16.0.1,16.0.2)',\
	com.google.gwt.thirdparty.streamhtmlparser;version='[0.0.10,0.0.11)',\
	com.vaadin.server;version='[7.3.10,7.3.11)',\
	com.vaadin.shared;version='[7.3.10,7.3.11)',\
	javax.jdo;version='[3.1.0,3.1.1)',\
	joda-time;version='[2.6.0,2.6.1)',\
	org.amdatu.persistence2_1;version='[1.0.0,1.0.1)',\
	org.apache.camel.camel-core;version='[2.15.0,2.15.1)',\
	org.apache.felix.configadmin;version='[1.8.4,1.8.5)',\
	org.apache.felix.fileinstall;version='[3.5.0,3.5.1)',\
	org.apache.felix.http.api;version='[2.3.2,2.3.3)',\
	org.apache.felix.http.servlet-api;version='[1.0.0,1.0.1)',\
	org.apache.felix.log;version='[1.0.1,1.0.2)',\
	org.apache.felix.scr;version='[1.8.2,1.8.3)',\
	org.apache.geronimo.specs.geronimo-jta_1.1_spec;version='[1.1.1,1.1.2)',\
	org.apache.xbean.bundleutils;version='[4.2.0,4.2.1)',\
	org.apache.xbean.finder;version='[4.2.0,4.2.1)',\
	org.json;version='[0.0.20080701,0.0.20080702)',\
	org.jsoup;version='[1.6.3,1.6.4)',\
	org.objectweb.asm.all;version='[5.0.3,5.0.4)',\
	org.ops4j.pax.web.pax-web-jetty-bundle;version='[4.1.2,4.1.3)',\
	org.w3c.flute;version='[1.3.0,1.3.1)',\
	osgi.residential;version='[4.3.0,4.3.1)',\
	slf4j.api;version='[1.7.7,1.7.8)'