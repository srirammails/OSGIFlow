-buildpath:  \
	osgi.core,\
	osgi.cmpn,\
	biz.aQute.bnd.annotation,\
	${junit},\
	slf4j.api;version=1.7,\
	slf4j.simple;version=1.7,\
	org.apache.camel.camel-core;version=2.15,\
	org.apache.camel.camel-core-osgi;version=2.15
Bundle-Version: 1.0.0.SNAPSHOT
Bundle-Classpath:.,lib/kafka_2.10-0.8.2-beta.jar,\
				   lib/scala-library-2.11.6.jar,\
				   lib/zkclient-0.3.jar,\
				   lib/zookeeper-3.4.6.jar,\
				   
Include-Resource:libs
bin: target/classes
src: src/main/java
target-dir: target
testbin: target/test-classes
testsrc: src/main/test
Import-Package: *;resolution:=optional
Export-Package:  \
	org.apache.camel.component.kafka
-runfw: org.apache.felix.framework;version='[4.4.1,4.4.1]'
-runee: JavaSE-1.7
-resolve: auto
-runrequires:  \
	osgi.identity;filter:='(&(osgi.identity=org.apache.camel.camel-core)(version>=2.15.0))',\
	osgi.identity;filter:='(&(osgi.identity=org.apache.camel.camel-core-osgi)(version>=2.15.0))',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.command)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.runtime)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.shell)',\
	osgi.identity;filter:='(&(osgi.identity=org.apache.servicemix.bundles.kafka-clients)(version>=0.8.2.0_1))',\
	osgi.identity;filter:='(&(osgi.identity=org.apache.servicemix.bundles.kafka_2.10)(version>=0.8.2.0_1))',\
	osgi.identity;filter:='(&(osgi.identity=org.apache.servicemix.bundles.metrics-annotation)(version>=2.2.0.1))',\
	osgi.identity;filter:='(&(osgi.identity=org.apache.servicemix.bundles.metrics-core)(version>=2.2.0.1))'
-runbundles:  \
	ch.qos.logback.classic;version='[1.1.2,1.1.3)',\
	ch.qos.logback.core;version='[1.1.2,1.1.3)',\
	log4j;version='[1.2.17,1.2.18)',\
	org.apache.camel.camel-core;version='[2.15.0,2.15.1)',\
	org.apache.camel.camel-core-osgi;version='[2.15.0,2.15.1)',\
	org.apache.felix.gogo.command;version='[0.14.0,0.14.1)',\
	org.apache.felix.gogo.runtime;version='[0.10.0,0.10.1)',\
	org.apache.felix.gogo.runtime;version='[0.12.1,0.12.2)',\
	org.apache.felix.gogo.shell;version='[0.10.0,0.10.1)',\
	org.apache.hadoop.zookeeper;version='[3.3.6,3.3.7)',\
	org.apache.servicemix.bundles.kafka-clients;version='[0.8.2,0.8.3)',\
	org.apache.servicemix.bundles.kafka_2.10;version='[0.8.2,0.8.3)',\
	org.apache.servicemix.bundles.metrics-annotation;version='[2.2.0,2.2.1)',\
	org.apache.servicemix.bundles.metrics-core;version='[2.2.0,2.2.1)',\
	org.ops4j.pax.logging.pax-logging-api;version='[1.8.1,1.8.2)',\
	org.scala-lang.scala-library;version='[2.11.5,2.11.6)',\
	org.scala-lang.scala-parser-combinators;version='[2.11.0,2.11.1)',\
	osgi.residential;version='[4.3.0,4.3.1)',\
	slf4j.api;version='[1.7.7,1.7.8)'