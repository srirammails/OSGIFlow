-buildpath:  \
	osgi.core,\
	osgi.cmpn,\
	biz.aQute.bnd.annotation,\
	${junit},\
	org.camunda.bpm,\
	org.camunda.bpm.extension.osgi,\
	org.camunda.bpm.model.camunda-bpmn-model,\
	osgi.enterprise;version=4.2,\
	com.springsource.com.mysql.jdbc;version=5.1
Bundle-Version: 0.0.0.${tstamp}
Service-Component:  \
	*
-runfw: org.apache.felix.framework;version='[4.4.1,4.4.1]'
-runee: JavaSE-1.7
-runrequires:  \
	osgi.identity;filter:='(osgi.identity=org.camunda.bpm)',\
	osgi.identity;filter:='(osgi.identity=org.camunda.bpm.extension.osgi)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.scr)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.configadmin)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.fileinstall)',\
	osgi.identity;filter:='(osgi.identity=org.camunda.bpm.model.camunda-xml-model)',\
	osgi.identity;filter:='(&(osgi.identity=joda-time)(version>=2.6.0))',\
	osgi.identity;filter:='(osgi.identity=org.camunda.bpm.model.camunda-bpmn-model)',\
	osgi.identity;filter:='(&(osgi.identity=osgi.cmpn)(version>=4.3.1.201210102024))',\
	osgi.identity;filter:='(&(osgi.identity=com.springsource.com.mysql.jdbc)(version>=5.1.6))',\
	osgi.identity;filter:='(&(osgi.identity=osgi.enterprise)(version>=4.2.0.201003190513))'
-resolve: auto
Export-Package:  \
	com.flow.camunda.osgi.api
-runbundles:  \
	com.springsource.com.mysql.jdbc;version='[5.1.6,5.1.7)',\
	com.springsource.org.apache.commons.logging;version='[1.1.1,1.1.2)',\
	joda-time;version='[2.6.0,2.6.1)',\
	org.apache.felix.configadmin;version='[1.8.2,1.8.3)',\
	org.apache.felix.fileinstall;version='[3.4.0,3.4.1)',\
	org.apache.felix.scr;version='[1.8.2,1.8.3)',\
	org.camunda.bpm;version='[7.2.0,7.2.1)',\
	org.camunda.bpm.extension.osgi;version='[1.1.0,1.1.1)',\
	org.camunda.bpm.model.camunda-bpmn-model;version='[7.2.0,7.2.1)',\
	org.camunda.bpm.model.camunda-cmmn-model;version='[7.2.0,7.2.1)',\
	org.camunda.bpm.model.camunda-xml-model;version='[7.2.0,7.2.1)',\
	org.mybatis.mybatis;version='[3.2.8,3.2.9)',\
	osgi.cmpn;version='[5.0.0,5.0.1)',\
	osgi.enterprise;version='[5.0.0,5.0.1)'
Private-Package:  \
	com.flow.camunda.osgi,\
	com.flow.osgi.mysql
Bundle-Activator: com.flow.osgi.mysql.Activator